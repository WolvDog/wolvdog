{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "wolverbark-web",
      "runtimeExecutable": "npx",
      "runtimeArgs": [
        "expo",
        "start",
        "--web",
        "--port",
        "8081",
        "--clear"
      ],
      "port": 8081
    },
    {
      "name": "wolverbark-dist",
      "runtimeExecutable": "npx",
      "runtimeArgs": [
        "expo",
        "serve",
        "--port",
        "8090"
      ],
      "port": 8090
    },
    {
      "name": "site",
      "runtimeExecutable": "python",
      "runtimeArgs": [
        "-m",
        "http.server",
        "8095",
        "--directory",
        "Site"
      ],
      "port": 8095
    }
  ]
}