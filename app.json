{
  "expo": {
    "name": "WolverBark",
    "slug": "wolverbark",
    "scheme": "wolverbark",
    "version": "0.1.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.wolverbark.app"
    },
    "android": {
      "package": "com.wolverbark.app",
      "permissions": [
        "POST_NOTIFICATIONS"
      ],
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#1850BE"
      }
    },
    "web": {
      "bundler": "metro",
      "output": "single",
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-font",
      [
        "expo-notifications",
        {
          "color": "#1E3A8A"
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 220,
          "resizeMode": "contain",
          "backgroundColor": "#1850BE"
        }
      ],
      [
        "expo-audio",
        {
          "microphonePermission": false,
          "recordAudioAndroid": false
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "icon": "./assets/icon.png",
    "owner": "maarcosramalhos-team",
    "extra": {
      "eas": {
        "projectId": "cfe3ee50-f603-4b70-8920-cfdb3965b3d3"
      }
    },
    "runtimeVersion": {
      "policy": "appVersion"
    }
  }
}
