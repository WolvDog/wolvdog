{
  "expo": {
    "name": "WolverBark",
    "slug": "wolverbark",
    "scheme": "wolverbark",
    "version": "0.1.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.wolverbark.app"
    },
    "android": {
      "package": "com.wolverbark.app",
      "permissions": [
        "POST_NOTIFICATIONS"
      ]
    },
    "web": {
      "bundler": "metro",
      "output": "single"
    },
    "plugins": [
      "expo-router",
      "expo-font",
      [
        "expo-notifications",
        {
          "color": "#1E3A8A"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
