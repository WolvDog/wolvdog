# Supabase (deixe vazio para usar os mocks locais)
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=
# RevenueCat: as chaves públicas ficam em constants/revenuecat.ts
# 1 = compras simuladas (testadores); vazio = compras reais
